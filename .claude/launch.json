{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eccentric-ideator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "eccentric-ideator-prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=production",
        "PORT=3001",
        "npx",
        "tsx",
        "dev-server.ts"
      ],
      "port": 3001
    }
  ]
}